# ===== LLM 配置（和 P0 共用，填你的 DeepSeek 或 OpenAI key）=====
OPENAI_API_KEY=sk-你的key

# DeepSeek 配置（你 P0 用的就是这个）
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-v4-flash

# ===== Embeddings 配置（Ollama 本地模型）=====
# 用户已通过 Ollama 安装 bge-m3 模型，用于文本向量化
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_BASE_URL=http://localhost:11434

# ===== Milvus 向量数据库配置 =====
# 用户已通过 Docker 安装 Milvus，默认端口 19530
MILVUS_URI=http://localhost:19530
MILVUS_COLLECTION=p1_rag_docs
